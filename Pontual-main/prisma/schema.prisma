// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  name      String?
  password  String
  role      Role     @default(CLIENT)
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Multi-seat / Sub-user functionality
  parentUserId String?
  parentUser   User?    @relation("UserSubUsers", fields: [parentUserId], references: [id], onDelete: Cascade)
  subUsers     User[]   @relation("UserSubUsers")

  // Biometric Provider ("ANVIZ" or "SUPREMA")
  biometricProvider String? @default("ANVIZ")
  
  // Token for Local Sync Agent (for Suprema / On-Premise clients)
  syncToken         String? @unique

  // CrossChex Credentials per client (for Anviz clients)
  apiKey    String?
  apiSecret String?
  apiUrl    String?  @default("https://api.eu.crosschexcloud.com/")

  // Report Settings
  reportHeader      String?
  logoUrl           String?
  vpEmail          String?
  autoEmailReports Boolean @default(false)

  // Schedules associated with this client
  schedules Schedule[]
  
  // Local/Synced Attendance Logs (from Suprema BioStar or local agents)
  attendanceLogs AttendanceLog[]
}

model Schedule {
  id            String   @id @default(cuid())
  name          String
  startTime     String   @default("08:30") // Format "HH:mm"
  endTime       String   @default("17:30") // Format "HH:mm"
  lateTolerance Int      @default(20)      // Minutes
  lunchDuration Int      @default(60)      // Minutes
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  employeeSchedules EmployeeSchedule[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  workno     String   // Employee ID (CrossChex or Suprema)
  
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workno, scheduleId])
}

model AttendanceLog {
  id           String   @id @default(cuid())
  userId       String   // Company / Client ID in Pontual
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workno       String   // Employee ID in BioStar 2
  employeeName String?
  checktime    DateTime
  checktype    Int      @default(1) // 1 = Entry / In, 2 = Exit / Out
  deviceName   String?  // e.g. "BioEntry W2 Portão Principal"
  deviceSn     String?
  rawEventId   String?  // Unique event ID from BioStar to avoid duplicates
  
  createdAt    DateTime @default(now())

  @@unique([userId, rawEventId])
  @@index([userId, checktime])
}

model AuditLog {
  id           String   @id @default(cuid())

  // Quem fez a acao (login do utilizador - ex: CMB1, CMB2)
  actorId      String
  actorName    String?

  // Conta cliente afetada (ex: CMB parent)
  clientId     String

  // Tipo de acao: CORRECTION | MANUAL_INSERT | DELETE | LOGIN | EXPORT
  action       String

  // Colaborador visado (quando aplicavel)
  targetWorkno String?
  targetName   String?

  // Valores antes/depois (string JSON)
  oldValue     String?
  newValue     String?

  // Contexto livre
  description  String?
  ipAddress    String?

  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
}
