{
  "name": "Pontualidade - Relatorios Automaticos Gengibre",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            },
            {
              "field": "cronExpression",
              "expression": "0 8 26 * *"
            }
          ]
        }
      },
      "name": "Schedule (Segundas e Dia 26 as 08:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "/usr/bin/node /opt/pontual/gengibre-automation/gengibre_reporter.js --send"
      },
      "name": "Executar Automacao Gengibre",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Schedule (Segundas e Dia 26 as 08:00)": {
      "main": [
        [
          {
            "node": "Executar Automacao Gengibre",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
