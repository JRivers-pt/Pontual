// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  name      String?
  password  String
  role      Role     @default(CLIENT)
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // CrossChex Credentials per client (optional for Master Admin)
  apiKey    String?
  apiSecret String?
  apiUrl    String?  @default("https://api.eu.crosschexcloud.com/")

  // Report Settings
  reportHeader      String?
  logoUrl           String?
  vpEmail          String?
  autoEmailReports Boolean @default(false)
  reportCycle      String? @default("CALENDAR_MONTH") // "CALENDAR_MONTH" (1st to end) or "CUTOFF_26_25" (26th to 25th)

  // Per-client calculation rules (override company-name detection)
  overtimeTolerance       Int?    // Min de tolerância para contar horas extra
  subtractTolerance       Boolean? // Subtrai a tolerância ao total de HE
  mealBreakMinutes        Int?    // Duração da pausa de refeição (min)
  mealBreakThresholdHours Int?    // Limiar de horas para deduzir pausa (h)
  exemptIds               String? // IDs isentos de HE, separados por vírgula
  overtimeCapHours        Int?    // Limite de horas normais por dia (h)

  // Schedules associated with this client
  schedules Schedule[]

  // Missed punches added manually
  missedPunches MissedPunch[]
}

model Schedule {
  id        String   @id @default(cuid())
  name      String
  startTime String   @default("08:30") // Format "HH:mm"
  endTime   String   @default("17:30") // Format "HH:mm"
  lateTolerance Int  @default(20)      // Minutes
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  employeeSchedules EmployeeSchedule[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  workno     String   // ID from CrossChex
  
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workno, scheduleId])
}

model MissedPunch {
  id         String   @id @default(cuid())
  workno     String
  firstName  String
  lastName   String
  checktime  DateTime
  checktype  Int      // 0: Check-In, 1: Check-Out, 2: Break Start, 3: Break End, 128: Overtime In, 129: Overtime Out
  device     String   @default("Manual")
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
